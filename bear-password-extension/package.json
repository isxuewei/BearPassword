{
  "name": "bear-password-extension",
  "version": "26.6.20",
  "description": "BearPassword 浏览器扩展 — 网页自动填充、保险库管理与两步验证",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' vite",
    "build": "vue-tsc --noEmit && vite build",
    "package": "npm run build && node scripts/package-zip.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "otpauth": "^9.5.1",
    "pinia": "^2.3.0",
    "tssrp6a": "^3.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0"
  },
  "author": "薛伟同学",
  "license": "MIT"
}
